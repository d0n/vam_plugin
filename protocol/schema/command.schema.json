{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/d0n/vam_plugin/protocol/schema/command.schema.json",
  "title": "AIBody command (companion -> plugin), protocol v1",
  "type": "object",
  "required": ["type"],
  "properties": {
    "v": { "const": 1 },
    "type": {
      "enum": ["ping", "speak", "stop_speaking", "expression", "set_morphs", "reset_morphs",
               "gesture", "pose", "trigger", "idle", "breathing"]
    },
    "id": { "type": "string", "description": "Unique id; echoed as reply_to / utterance_id" },
    "ts": { "type": "number", "description": "Unix time in seconds" },
    "ack": { "type": "boolean", "description": "Request an ack event on success" },
    "audio": { "type": "string", "description": "speak: audio file path relative to the VaM folder" },
    "text": { "type": "string", "description": "speak: the spoken text (informational)" },
    "expression": { "type": "string", "description": "speak: expression to show while speaking" },
    "intensity": { "type": "number", "minimum": 0 },
    "name": { "type": "string" },
    "blend": { "type": "number", "minimum": 0, "description": "seconds to blend" },
    "hold": { "type": "number", "description": "expression: seconds before returning to neutral (<=0 = keep)" },
    "morphs": { "type": "object", "additionalProperties": { "type": "number" } },
    "release_others": { "type": "boolean" },
    "duration": { "type": "number", "minimum": 0 },
    "amplitude": { "type": "number", "minimum": 0 },
    "path": { "type": "string", "description": "pose: preset path, may include a .var reference" },
    "storable": { "type": "string", "description": "trigger: storable id or suffix" },
    "action": { "type": "string" },
    "param": { "type": "string" },
    "value": { "type": ["string", "number", "boolean"] },
    "value_type": { "enum": ["float", "bool", "string", "chooser"] },
    "enabled": { "type": "boolean" },
    "rate": { "type": "number", "minimum": 0 },
    "depth": { "type": "number", "minimum": 0 }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "speak" } } }, "then": { "required": ["audio"] } },
    { "if": { "properties": { "type": { "const": "expression" } } }, "then": { "required": ["name"] } },
    { "if": { "properties": { "type": { "const": "set_morphs" } } }, "then": { "required": ["morphs"] } },
    { "if": { "properties": { "type": { "const": "gesture" } } }, "then": { "required": ["name"] } },
    { "if": { "properties": { "type": { "const": "pose" } } }, "then": { "required": ["path"] } },
    { "if": { "properties": { "type": { "const": "trigger" } } },
      "then": { "required": ["storable"], "anyOf": [{ "required": ["action"] }, { "required": ["param", "value"] }] } }
  ]
}
