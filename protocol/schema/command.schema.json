{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/d0n/vam_plugin/protocol/schema/command.schema.json",
  "title": "AIBody message companion app -> AIBody plugin (\"command\"), protocol v3",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "v": {
      "const": 3
    },
    "type": {
      "enum": [
        "ping",
        "speak",
        "stop_speaking",
        "expression",
        "set_morphs",
        "reset_morphs",
        "gesture",
        "pose",
        "trigger",
        "idle",
        "breathing",
        "config_ack",
        "mic_state",
        "mic_level",
        "companion_heartbeat"
      ]
    },
    "id": {
      "type": "string",
      "description": "Unique id; echoed as reply_to / utterance_id"
    },
    "ts": {
      "type": "number",
      "description": "Unix time in seconds"
    },
    "ack": {
      "type": "boolean",
      "description": "Request an ack event on success"
    },
    "audio": {
      "type": "string",
      "description": "speak: audio file path relative to the VaM folder (default Custom/Sounds/AIBody/<channel>/...)"
    },
    "text": {
      "type": "string",
      "description": "speak: the spoken text (informational)"
    },
    "expression": {
      "type": "string",
      "description": "speak: expression to show while speaking"
    },
    "intensity": {
      "type": "number",
      "minimum": 0
    },
    "name": {
      "type": "string"
    },
    "blend": {
      "type": "number",
      "minimum": 0,
      "description": "seconds to blend"
    },
    "hold": {
      "type": "number",
      "description": "expression: seconds before returning to neutral (<=0 = keep)"
    },
    "morphs": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "release_others": {
      "type": "boolean"
    },
    "duration": {
      "type": "number",
      "minimum": 0,
      "description": "speak: expected clip length in s (informational); gesture: s"
    },
    "amplitude": {
      "type": "number",
      "minimum": 0
    },
    "path": {
      "type": "string",
      "description": "pose: preset path, may include a .var reference"
    },
    "storable": {
      "type": "string",
      "description": "trigger: storable id or suffix"
    },
    "action": {
      "type": "string"
    },
    "param": {
      "type": "string"
    },
    "value": {
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "value_type": {
      "enum": [
        "float",
        "bool",
        "string",
        "chooser"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "rate": {
      "type": "number",
      "minimum": 0
    },
    "depth": {
      "type": "number",
      "minimum": 0
    },
    "queue": {
      "enum": [
        "append",
        "interrupt"
      ],
      "description": "speak: append to the playback queue (default) or stop current speech and clear the queue"
    },
    "reply_to": {
      "type": "string"
    },
    "applied": {
      "type": "object",
      "description": "config_ack: settings in effect, e.g. {\"mic\": {...}}"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mic_state": {
      "type": "object",
      "description": "config_ack: same fields as a mic_state message"
    },
    "error": {
      "type": "string"
    },
    "vad": {
      "type": "string",
      "description": "mic_state: the voice detector that really runs, e.g. 'energy (built-in, adaptive noise floor), strictness 2'"
    },
    "vad_note": {
      "type": "string",
      "description": "mic_state: why the chosen voice detector is not used (e.g. webrtcvad not installed); absent when all is as chosen"
    },
    "capturing": {
      "type": "boolean"
    },
    "mode": {
      "type": "object",
      "description": "companion_heartbeat: pipeline mode",
      "properties": {
        "requested": {
          "enum": [
            "qa",
            "auto",
            "realtime",
            "chain"
          ]
        },
        "active": {
          "enum": [
            "realtime",
            "chain"
          ]
        },
        "status": {
          "type": "string"
        }
      }
    },
    "ptt_active": {
      "type": "boolean"
    },
    "rms": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "mic_level: peak RMS (0..1) since the last level message"
    },
    "speech": {
      "type": "boolean"
    },
    "gate_open": {
      "type": "boolean"
    },
    "session": {
      "type": "string",
      "description": "companion_heartbeat: id that changes on every companion start (the AIBody plugin then re-sends ready + config)"
    },
    "version": {
      "type": "string",
      "description": "companion_heartbeat: companion version"
    },
    "engines_available": {
      "type": "object",
      "description": "companion_heartbeat: engine names per kind, fills the AIBody plugin's engine menus",
      "properties": {
        "stt": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "llm": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "mic_capturing": {
      "type": "boolean",
      "description": "companion_heartbeat: microphone open"
    },
    "engines_status": {
      "type": "object",
      "description": "companion_heartbeat: kind -> engine -> status text (\"bereit (...)\" / \"nicht konfiguriert: ...\")"
    },
    "engines_active": {
      "type": "object",
      "description": "companion_heartbeat: kind -> engine that really runs (a fallback if the selected one is not configured)"
    },
    "proactive": {
      "type": "object",
      "description": "companion_heartbeat: proactive timer",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "idle_seconds": {
          "type": "number"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "keys": {
      "type": "object",
      "description": "companion_heartbeat: API key status per provider (xai, elevenlabs): state configured | missing | rejected, detail = where the key comes from / why it is missing, hint = which kind of key works (never the key)",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "state": {
            "enum": [
              "configured",
              "missing",
              "rejected"
            ]
          },
          "detail": {
            "type": "string"
          },
          "hint": {
            "type": "string",
            "description": "when missing / rejected: which key works (xAI: an API key from console.x.ai; a Grok subscription / grok.com token does not)"
          }
        }
      }
    },
    "audio_out": {
      "type": "object",
      "description": "companion_heartbeat: folder (below the VaM folder) the speech WAVs are written to; auto = chosen automatically (Custom/Sounds/AIBody/<channel>, switched once to Saves/PluginData/AIBody/<channel>/audio if VaM cannot load them); note = audio folder problem / switch",
      "properties": {
        "folder": {
          "type": "string"
        },
        "auto": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "turn": {
      "type": "string",
      "description": "companion_heartbeat: last question / answer step or problem (\"Gehört: ...\", \"Antwort ...\", \"Sprachmodell-Fehler: ...\"), shown in the plugin's status box"
    },
    "latency": {
      "type": "object",
      "description": "companion_heartbeat: time from the end of the user's speech to the first sound {last_s, avg_s, n, parts}"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "speak"
          }
        }
      },
      "then": {
        "required": [
          "audio"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "expression"
          }
        }
      },
      "then": {
        "required": [
          "name"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "set_morphs"
          }
        }
      },
      "then": {
        "required": [
          "morphs"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "gesture"
          }
        }
      },
      "then": {
        "required": [
          "name"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "pose"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "path"
            ]
          },
          {
            "required": [
              "name"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "trigger"
          }
        }
      },
      "then": {
        "required": [
          "storable"
        ],
        "anyOf": [
          {
            "required": [
              "action"
            ]
          },
          {
            "required": [
              "param",
              "value"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "mic_state"
          }
        }
      },
      "then": {
        "required": [
          "enabled",
          "capturing"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "mic_level"
          }
        }
      },
      "then": {
        "required": [
          "rms"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "companion_heartbeat"
          }
        }
      },
      "then": {
        "required": [
          "session"
        ]
      }
    }
  ]
}
