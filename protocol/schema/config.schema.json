{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/d0n/vam_plugin/protocol/schema/config.schema.json",
  "title": "AIBody shared settings: <VaM>/Saves/PluginData/AIBody/config.json (one object per plugin tab, plus 'ai' for the companion app; the 'Status' tab has no settings)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "anyOf": [
        {
          "const": 1
        },
        {
          "const": "1"
        }
      ]
    },
    "written_by": {
      "type": "string"
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": true
        },
        "network_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": true
        },
        "network_port": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 38437
        },
        "paths": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "expressions": {
              "type": "string",
              "default": "Saves/PluginData/AIBody/expressions.json",
              "pattern": "^(Saves|Custom)/"
            },
            "gestures": {
              "type": "string",
              "default": "Saves/PluginData/AIBody/gestures.json",
              "pattern": "^(Saves|Custom)/"
            },
            "audio": {
              "type": "string",
              "default": "",
              "pattern": "^$|^(Saves|Custom)/"
            }
          }
        }
      },
      "description": "Connection (link on/off in tab 'Voice'): data file paths (relative to the VaM folder, below Saves/ or Custom/)"
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stt": {
          "type": "string",
          "default": "null"
        },
        "llm": {
          "type": "string",
          "default": "echo"
        },
        "tts": {
          "type": "string",
          "default": "tone"
        }
      },
      "description": "Tab 'Voice', section 'Voice > AI Character': stt null|xai, llm echo|xai, tts tone|xai|elevenlabs. A cloud engine without API key stays selected but the fallback (ai.fallback) runs"
    },
    "mic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": true
        },
        "mode": {
          "type": "string",
          "default": "vad",
          "enum": [
            "vad",
            "ptt"
          ]
        },
        "vad_threshold": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.001,
              "maximum": 0.5
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 0.01
        },
        "vad_engine": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "energy",
            "webrtc",
            "silero"
          ]
        },
        "vad_strictness": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 2
        },
        "end_silence_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 200,
              "maximum": 5000
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 700
        },
        "min_utterance_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 5000
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 300
        },
        "max_utterance_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1000,
              "maximum": 60000
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 20000
        },
        "echo_tail_s": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.0,
              "maximum": 3.0
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 0.4
        },
        "gain": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.1,
              "maximum": 8.0
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 1.0
        },
        "ptt_interrupts": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": true
        },
        "level_meter": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": true
        }
      },
      "description": "Tab 'Client Character': captured by the companion app; push-to-talk state itself is never saved"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "speech_volume": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 1.0
        },
        "body_control": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": true
        },
        "idle_motion": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": true
        },
        "idle_intensity": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 0.5
        },
        "breathing": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": true
        },
        "breaths_per_minute": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 4.0,
              "maximum": 40.0
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 14.0
        },
        "breath_depth": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 0.35
        },
        "breath_morph": {
          "type": "string",
          "default": "Breath1"
        },
        "gaze_control": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": true
        },
        "gaze_default": {
          "type": "string",
          "default": "default"
        },
        "gaze_follows_speaker": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": false
        },
        "blink_control": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": false
        }
      },
      "description": "Tab 'AI Character', section 'Body (this Person only)'"
    },
    "advanced": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file_poll_interval_s": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.02,
              "maximum": 2.0
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 0.1,
          "description": "Slider 'Companion inbox poll interval (s)' (stored name 'File poll interval (s)'): how often the plugin checks the companion app's inbox folder Saves/PluginData/AIBody/<channel>/inbox/ for messages (speech, poses, expressions). Does not reload config.json"
        },
        "verbose_log": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": false
        }
      },
      "description": "Tab 'Config' (companion inbox poll interval, verbose log)"
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "first_run_hint_dismissed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": false
        }
      },
      "description": "Plugin UI state: first_run_hint_dismissed = the short note about the xAI token at the top of the plugin UI was closed or answered, so it is not shown again"
    },
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": false,
          "description": "true = the app opens the remote control (web page and HTTP API on http_port, OSC on osc_port if above 0). Default false"
        },
        "http_port": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 38438,
          "description": "TCP port of the web page and HTTP API on 127.0.0.1 (1024-65535, default 38438)"
        },
        "osc_port": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 0,
          "description": "UDP port of the OSC listener on 127.0.0.1; 0 = no OSC listener (default). OSC has no token"
        },
        "token": {
          "type": "string",
          "default": "",
          "description": "Secret the HTTP API requires (Authorization: Bearer <token>). Empty = the app generates one into this file when remote.enabled is true. Never share this file with a token in it"
        }
      },
      "description": "Remote control (version 31, file only, no tab; the plugin keeps this section unchanged): a local web page / HTTP API and an optional OSC listener of the companion app, off by default, bound to 127.0.0.1 only. Applies when the app starts. See docs/REMOTE.md"
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "default": "qa",
          "enum": [
            "qa",
            "auto",
            "realtime",
            "chain"
          ]
        },
        "persona": {
          "type": "string",
          "default": "You are a friendly, curious character living in a 3D scene. You talk with the user face to face. Answer briefly and naturally, in the language the user speaks.",
          "description": "Persona / system prompt for the language model (xAI: 'instructions')"
        },
        "language": {
          "type": "string",
          "default": "auto",
          "description": "'auto' or a language code (de, en, ...): STT bias and TTS language"
        },
        "persona_name": {
          "type": "string",
          "default": ""
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "enum": [
                    "true",
                    "false",
                    "True",
                    "False"
                  ]
                }
              ],
              "default": false
            },
            "max_facts": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                {
                  "type": "string",
                  "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
                }
              ],
              "default": 30
            },
            "session_idle_minutes": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 240
                },
                {
                  "type": "string",
                  "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
                }
              ],
              "default": 10
            },
            "min_exchanges": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                },
                {
                  "type": "string",
                  "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
                }
              ],
              "default": 2
            }
          }
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stt": {
              "type": "string",
              "default": "null",
              "enum": [
                "null",
                "xai"
              ]
            },
            "llm": {
              "type": "string",
              "default": "echo",
              "enum": [
                "echo",
                "xai",
                "ollama"
              ]
            },
            "tts": {
              "type": "string",
              "default": "tone",
              "enum": [
                "tone",
                "xai",
                "elevenlabs"
              ]
            }
          },
          "description": "Engines used when the selected one has no API key or a request fails"
        },
        "realtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "default": "wss://api.x.ai/v1/realtime"
            },
            "model": {
              "type": "string",
              "default": "grok-voice-latest"
            },
            "voice": {
              "type": "string",
              "default": "eve"
            },
            "sample_rate": {
              "anyOf": [
                {
                  "type": "integer",
                  "enum": [
                    8000,
                    16000,
                    22050,
                    24000,
                    32000,
                    44100,
                    48000
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
                }
              ],
              "default": 24000
            },
            "speed": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0.7,
                  "maximum": 1.5
                },
                {
                  "type": "string",
                  "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
                }
              ],
              "default": 1.0
            },
            "reasoning_effort": {
              "type": "string",
              "default": "none",
              "enum": [
                "none",
                "high"
              ]
            },
            "send_while_speaking": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "enum": [
                    "true",
                    "false",
                    "True",
                    "False"
                  ]
                }
              ],
              "default": false
            },
            "first_segment_s": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0.3,
                  "maximum": 5.0
                },
                {
                  "type": "string",
                  "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
                }
              ],
              "default": 1.2
            },
            "max_segment_s": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 1.0,
                  "maximum": 20.0
                },
                {
                  "type": "string",
                  "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
                }
              ],
              "default": 6.0
            },
            "connect_timeout_s": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 3.0,
                  "maximum": 60.0
                },
                {
                  "type": "string",
                  "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
                }
              ],
              "default": 15.0
            }
          }
        },
        "proactive": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "enum": [
                    "true",
                    "false",
                    "True",
                    "False"
                  ]
                }
              ],
              "default": true
            },
            "idle_seconds": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 3600.0
                },
                {
                  "type": "string",
                  "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
                }
              ],
              "default": 90.0
            },
            "prompt": {
              "type": "string",
              "default": "The user has been quiet for a while. You may say something short and spontaneous that fits the moment and your character (a remark, a thought, a question), or you may stay silent. If you prefer to stay silent, answer with exactly [silent] and nothing else."
            }
          }
        },
        "scene_events": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "enum": [
                    "true",
                    "false",
                    "True",
                    "False"
                  ]
                }
              ],
              "default": true
            },
            "prompt": {
              "type": "string",
              "default": "Something just happened in the scene: {event}. You may react briefly and in character if it fits, or you may stay silent. If you prefer to stay silent, answer with exactly [silent] and nothing else."
            }
          }
        },
        "emotion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fallback": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "enum": [
                    "true",
                    "false",
                    "True",
                    "False"
                  ]
                }
              ],
              "default": true
            },
            "fade": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "enum": [
                    "true",
                    "false",
                    "True",
                    "False"
                  ]
                }
              ],
              "default": true
            },
            "fade_after_s": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 1.0,
                  "maximum": 120.0
                },
                {
                  "type": "string",
                  "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
                }
              ],
              "default": 6.0
            },
            "fade_seconds": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0.2,
                  "maximum": 10.0
                },
                {
                  "type": "string",
                  "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
                }
              ],
              "default": 2.5
            },
            "listening": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "enum": [
                    "true",
                    "false",
                    "True",
                    "False"
                  ]
                }
              ],
              "default": true
            }
          }
        },
        "barge_in": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
