{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/d0n/vam_plugin/protocol/schema/config.schema.json",
  "title": "AIBody shared settings: <VaM>/Saves/PluginData/AIBody/config.json (one object per plugin tab, plus 'ai' for the companion app; the 'Status' tab has no settings)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "anyOf": [
        {
          "const": 1
        },
        {
          "const": "1"
        }
      ]
    },
    "written_by": {
      "type": "string"
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": true
        },
        "network_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": true
        },
        "network_port": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 38437
        },
        "paths": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "expressions": {
              "type": "string",
              "default": "Saves/PluginData/AIBody/expressions.json",
              "pattern": "^(Saves|Custom)/"
            },
            "gestures": {
              "type": "string",
              "default": "Saves/PluginData/AIBody/gestures.json",
              "pattern": "^(Saves|Custom)/"
            },
            "audio": {
              "type": "string",
              "default": "",
              "pattern": "^$|^(Saves|Custom)/"
            }
          }
        }
      },
      "description": "Connection (link on/off in tab 'Voice'): data file paths (relative to the VaM folder, below Saves/ or Custom/)"
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stt": {
          "type": "string",
          "default": "null"
        },
        "llm": {
          "type": "string",
          "default": "echo"
        },
        "tts": {
          "type": "string",
          "default": "tone"
        }
      },
      "description": "Tab 'Voice', section 'Voice > AI Character': stt null|xai, llm echo|xai, tts tone|xai|elevenlabs. A cloud engine without API key stays selected but the fallback (ai.fallback) runs"
    },
    "mic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": true
        },
        "mode": {
          "type": "string",
          "default": "vad",
          "enum": [
            "vad",
            "ptt"
          ]
        },
        "vad_threshold": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.001,
              "maximum": 0.5
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 0.01
        },
        "vad_engine": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "energy",
            "webrtc",
            "silero"
          ]
        },
        "vad_strictness": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 2
        },
        "end_silence_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 200,
              "maximum": 5000
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 700
        },
        "min_utterance_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 5000
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 300
        },
        "max_utterance_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1000,
              "maximum": 60000
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 20000
        },
        "echo_tail_s": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.0,
              "maximum": 3.0
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 0.4
        },
        "gain": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.1,
              "maximum": 8.0
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 1.0
        },
        "ptt_interrupts": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": true
        },
        "level_meter": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": true
        }
      },
      "description": "Tab 'Client Character': captured by the companion app; push-to-talk state itself is never saved"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "speech_volume": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 1.0
        },
        "body_control": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": true
        },
        "idle_motion": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": true
        },
        "idle_intensity": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 0.5
        },
        "breathing": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": true
        },
        "breaths_per_minute": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 4.0,
              "maximum": 40.0
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 14.0
        },
        "breath_depth": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 0.35
        },
        "breath_morph": {
          "type": "string",
          "default": "Breath1"
        },
        "idle_poses": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": true,
          "description": "Toggle 'Idle poses' (version 35): when nothing happens for a while the character takes an available pose of the pose commands by itself and next time goes back to idle_pose_default"
        },
        "idle_pose_min_s": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 10.0,
              "maximum": 1800.0
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 45.0,
          "description": "Slider 'Idle pose min wait (s)': shortest quiet time before an idle pose change (10-1800)"
        },
        "idle_pose_max_s": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 10.0,
              "maximum": 1800.0
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 120.0,
          "description": "Slider 'Idle pose max wait (s)': longest quiet time before an idle pose change (10-1800)"
        },
        "idle_pose_default": {
          "type": "string",
          "default": "Stand Up",
          "description": "Menu 'Idle default pose': the pose the character returns to between idle poses (a pose name of the character; not found = no return pose)"
        }
      },
      "description": "Tab 'AI Character', section 'Body (this Person only)'"
    },
    "advanced": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file_poll_interval_s": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.02,
              "maximum": 2.0
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 0.1,
          "description": "Slider 'Companion inbox poll interval (s)' (stored name 'File poll interval (s)'): how often the plugin checks the companion app's inbox folder Saves/PluginData/AIBody/<channel>/inbox/ for messages (speech, poses, expressions). Does not reload config.json"
        },
        "verbose_log": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": false
        }
      },
      "description": "Tab 'Config' (companion inbox poll interval, verbose log)"
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "first_run_hint_dismissed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": false
        },
        "background_setup_applied": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 0,
          "description": "The setup.revision whose background answer the plugin has applied (version 36; written by the plugin)"
        }
      },
      "description": "Plugin UI state: first_run_hint_dismissed = the short note about the xAI token at the top of the plugin UI was closed or answered, so it is not shown again"
    },
    "poses": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command",
              "pose"
            ],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "pose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          },
          "default": [
            {
              "command": "Sit Down",
              "pose": "Sit Down"
            },
            {
              "command": "Lay Down",
              "pose": "Lay Down"
            },
            {
              "command": "Prone",
              "pose": "Prone"
            },
            {
              "command": "Stand Up",
              "pose": "Stand Up"
            },
            {
              "command": "Spread Your Legs",
              "pose": "Spread Your Legs"
            },
            {
              "command": "Ankle Your Knees",
              "pose": "Ankle Your Knees"
            },
            {
              "command": "Ankle Your Elbows",
              "pose": "Ankle Your Elbows"
            },
            {
              "command": "Turn Around",
              "pose": "Turn Around"
            },
            {
              "command": "Crawl on all fours",
              "pose": "Crawl on all fours"
            },
            {
              "command": "Bend Over",
              "pose": "Bend Over"
            }
          ],
          "description": "List of {command, pose}: command = the text the user says or types (ten starter commands by default); pose = id of a pose of the character (gestures.json pose or pose file; names compare ignoring case, spaces, '_' and '-'). A command whose pose does not exist stays in the list, is shown as unavailable and is never applied. Missing key, empty list or a list without one usable entry = the ten starters (version 35)"
        }
      },
      "description": "Tab 'AI Character', section 'Pose commands' (version 32): the ONLY way a pose is applied. A pose is applied only when the user's WHOLE input equals a command text (case, extra spaces and trailing . ! ? ignored; no substring or fuzzy match). Written by the plugin ('Add Pose' / 'Delete Pose')"
    },
    "characters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "setup_answered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": false,
          "description": "true = the gate 'Do you want to configure your characters?' was answered (Yes or No). false = the question is shown again"
        },
        "setup_wanted": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": false,
          "description": "true = the user chose Yes (the gender steps are shown). false after answering = skipped, until 'Configure characters' is pressed"
        },
        "ai_gender": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "Female",
            "Male"
          ],
          "description": "Menu 'AI gender/body': Female, Male, or empty if not chosen yet"
        },
        "user_gender": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "Female",
            "Male"
          ],
          "description": "Menu 'Your character gender': Female, Male, or empty if not chosen yet"
        }
      },
      "description": "Tab 'AI Character', section 'Characters' (after version 37): answers of the character configuration wizard. Recorded as AI prompt context only; the plugin does not change a Person's gender, body or clothing (no evidenced API). Clothing is not stored."
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asked": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": false,
          "description": "true = the questions were answered (they are not asked again on start; Abort leaves it false)"
        },
        "background": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": false,
          "description": "Answer to 'Do you want a greenscreen background?': true = the plugin switches its toggle 'Set background color' (tab Config) on with background_color, once per revision"
        },
        "background_color": {
          "type": "string",
          "default": "#00FF00",
          "description": "Answer to 'Set your color for transparency' as #RRGGBB (default #00FF00, green)"
        },
        "choice": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "scene",
            "plugin"
          ],
          "description": "Answer to 'Choose what to use': scene = the app wrote Saves/scene/AIBody/AI-Buddy.json; plugin = nothing written; empty = not answered yet"
        },
        "revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 0,
          "description": "Grows by one with every answered setup; the plugin applies a background answer once per revision"
        }
      },
      "description": "First-start questions of the companion app (version 36, file only, no tab; the plugin only reads it). Asked once in the app's console; 'python -m aibody_companion --setup' asks again. Two independent points: the background (yes / no / abort, and its color) and what to use (Scene / Plugin)"
    },
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False"
              ]
            }
          ],
          "default": false,
          "description": "true = the app opens the remote control (web page and HTTP API on http_port, OSC on osc_port if above 0). Default false"
        },
        "http_port": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 38438,
          "description": "TCP port of the web page and HTTP API on 127.0.0.1 (1024-65535, default 38438)"
        },
        "osc_port": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            {
              "type": "string",
              "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
            }
          ],
          "default": 0,
          "description": "UDP port of the OSC listener on 127.0.0.1; 0 = no OSC listener (default). OSC has no token"
        },
        "token": {
          "type": "string",
          "default": "",
          "description": "Secret the HTTP API requires (Authorization: Bearer <token>). Empty = the app generates one into this file when remote.enabled is true. Never share this file with a token in it"
        }
      },
      "description": "Remote control (version 31, file only, no tab; the plugin keeps this section unchanged): a local web page / HTTP API and an optional OSC listener of the companion app, off by default, bound to 127.0.0.1 only. Applies when the app starts. See docs/REMOTE.md"
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "default": "qa",
          "enum": [
            "qa",
            "auto",
            "realtime",
            "chain"
          ]
        },
        "persona": {
          "type": "string",
          "default": "You are a friendly, curious character living in a 3D scene. You talk with the user face to face. Answer briefly and naturally, in the language the user speaks.",
          "description": "Persona / system prompt for the language model (xAI: 'instructions')"
        },
        "language": {
          "type": "string",
          "default": "auto",
          "description": "'auto' or a language code (de, en, ...): STT bias and TTS language"
        },
        "persona_name": {
          "type": "string",
          "default": ""
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "enum": [
                    "true",
                    "false",
                    "True",
                    "False"
                  ]
                }
              ],
              "default": false
            },
            "max_facts": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                {
                  "type": "string",
                  "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
                }
              ],
              "default": 30
            },
            "session_idle_minutes": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 240
                },
                {
                  "type": "string",
                  "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
                }
              ],
              "default": 10
            },
            "min_exchanges": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                },
                {
                  "type": "string",
                  "pattern": "^\\s*-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?\\s*$"
                }
              ],
              "default": 2
            }
          }
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stt": {
              "type": "string",
              "default": "null",
              "enum": [
                "null",
                "xai"
              ]
            },
            "llm": {
              "type": "string",
              "default": "echo",
              "enum": [
                "echo",
                "xai",
                "ollama"
              ]
            },
            "tts": {
              "type": "string",
              "default": "tone",
              "enum": [
