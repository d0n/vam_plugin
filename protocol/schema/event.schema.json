{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/d0n/vam_plugin/protocol/schema/event.schema.json",
  "title": "AIBody message AIBody plugin -> companion app (\"event\"), protocol v3",
  "type": "object",
  "required": [
    "v",
    "type",
    "id",
    "ts"
  ],
  "properties": {
    "v": {
      "const": 3
    },
    "type": {
      "enum": [
        "ready",
        "heartbeat",
        "pong",
        "ack",
        "error",
        "speech_started",
        "speech_ended",
        "gesture_done",
        "scene_event",
        "memory_forget",
        "shutdown",
        "config",
        "ptt",
        "test_tone",
        "reconnect"
      ]
    },
    "id": {
      "type": "string"
    },
    "ts": {
      "type": "number"
    },
    "reply_to": {
      "type": "string",
      "description": "id of the command this answers"
    },
    "command": {
      "type": "string",
      "description": "ack: command type"
    },
    "code": {
      "enum": [
        "bad_json",
        "command_failed",
        "audio_failed"
      ]
    },
    "message": {
      "type": "string"
    },
    "utterance_id": {
      "type": "string",
      "description": "speech_*: id of the speak command"
    },
    "reason": {
      "enum": [
        "completed",
        "stopped",
        "interrupted",
        "cancelled",
        "failed"
      ]
    },
    "name": {
      "type": "string",
      "description": "gesture_done: gesture name"
    },
    "text": {
      "type": "string",
      "description": "scene_event: text a VaM trigger set in the plugin's 'Scene event' string (the AI may react)"
    },
    "plugin_version": {
      "type": "string"
    },
    "protocol": {
      "type": "integer"
    },
    "atom": {
      "type": "string",
      "description": "ready/heartbeat/pong: uid of the Person atom the plugin is on (informational)"
    },
    "channel": {
      "type": "string"
    },
    "transport": {
      "enum": [
        "file",
        "none"
      ]
    },
    "speaking": {
      "type": "boolean"
    },
    "expression": {
      "type": "string"
    },
    "audio_dir": {
      "type": "string"
    },
    "expressions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gestures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "duration": {
      "type": "number",
      "description": "speech_started: clip length in s"
    },
    "queue_length": {
      "type": "integer",
      "description": "speech_ended: utterances still queued"
    },
    "speech_queue": {
      "type": "integer"
    },
    "link": {
      "enum": [
        "file",
        "none"
      ]
    },
    "active": {
      "type": "boolean",
      "description": "ptt: push-to-talk pressed"
    },
    "mic": {
      "type": "object",
      "description": "config: microphone settings",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "vad",
            "ptt"
          ]
        },
        "device": {
          "type": "string",
          "description": "Retired (no microphone selection): the system default input is always used; an old value is ignored."
        },
        "vad_threshold": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 0.5
        },
        "vad_engine": {
          "type": "string",
          "enum": [
            "auto",
            "energy",
            "webrtc",
            "silero"
          ],
          "description": "Voice detector: auto = silero if its model file is there, else webrtcvad if installed, else the built-in one"
        },
        "vad_strictness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "0..3: higher = ignores more background noise"
        },
        "end_silence_ms": {
          "type": "integer",
          "minimum": 200,
          "maximum": 5000
        },
        "min_utterance_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 5000
        },
        "max_utterance_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000
        },
        "echo_tail_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "gain": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 8
        },
        "ptt_interrupts": {
          "type": "boolean"
        },
        "level_meter": {
          "type": "boolean"
        }
      }
    },
    "engines": {
      "type": "object",
      "description": "config: engines picked in the AIBody plugin",
      "properties": {
        "stt": {
          "type": "string"
        },
        "llm": {
          "type": "string"
        },
        "tts": {
          "type": "string"
        }
      }
    },
    "advanced": {
      "type": "object",
      "description": "config: the Erweitert tab (verbose_log = companion turn trace on/off)",
      "properties": {
        "verbose_log": {
          "type": [
            "boolean",
            "string"
          ]
        }
      }
    },
    "poses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "ready/heartbeat: gestures.json entries of kind pose (the AI's pose tool)"
    },
    "body_control": {
      "type": [
        "boolean",
        "string"
      ],
      "description": "ready/heartbeat: Body control on (false = speech only, no body tools for the AI)"
    },
    "gaze_control": {
      "type": [
        "boolean",
        "string"
      ],
      "description": "ready/heartbeat: the AI may direct the gaze (menu switch 'Gaze control' on, no other eye plugin such as Glance on the Person, eyes not taken by someone else); false = the companion offers no look_at tool"
    },
    "gaze_atoms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "ready/heartbeat: names (uids) of atoms in the scene the AI can look at with look_at target 'atom' (at most 30, this Person excluded)"
    },
    "selftest": {
      "type": "object",
      "description": "ready/heartbeat: in-game self test of the body (Body.SelfTestJson): pose_storage (ok or why not), pose_files, poses, breath_morph, breath_morph_found, expression_morphs_found / _total / _missing, timeline_gestures, timeline, or error; the companion logs it once per change"
    },
    "keys": {
      "type": "object",
      "description": "config: API tokens typed into the plugin (version 21: keys.xai = the 'XAI API Token' field, plain text without format check, \"\" = field empty; wins over XAI_API_KEY and ai.xai.key_file). Only travels in the config event files; never written to config.json, never logged",
      "properties": {
        "xai": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "config"
          }
        }
      },
      "then": {
        "required": [
          "mic"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ptt"
          }
        }
      },
      "then": {
        "required": [
          "active"
        ]
      }
    }
  ]
}
