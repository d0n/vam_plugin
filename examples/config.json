{
  "version": 1,
  "written_by": "AIBody companion app 35 (example)",
  "connection": {
    "active": true,
    "network_active": true,
    "network_port": 38437,
    "paths": {
      "expressions": "Saves/PluginData/AIBody/expressions.json",
      "gestures": "Saves/PluginData/AIBody/gestures.json",
      "audio": ""
    }
  },
  "engines": {
    "stt": "null",
    "llm": "echo",
    "tts": "tone"
  },
  "mic": {
    "enabled": true,
    "mode": "vad",
    "vad_threshold": 0.01,
    "vad_engine": "auto",
    "vad_strictness": 2,
    "end_silence_ms": 700,
    "min_utterance_ms": 300,
    "max_utterance_ms": 20000,
    "echo_tail_s": 0.4,
    "gain": 1.0,
    "ptt_interrupts": true,
    "level_meter": true
  },
  "body": {
    "speech_volume": 1.0,
    "body_control": true,
    "idle_motion": true,
    "idle_intensity": 0.5,
    "breathing": true,
    "breaths_per_minute": 14.0,
    "breath_depth": 0.35,
    "breath_morph": "Breath1",
    "gaze_control": true,
    "gaze_default": "default",
    "gaze_follows_speaker": false,
    "blink_control": false,
    "idle_poses": true,
    "idle_pose_min_s": 45.0,
    "idle_pose_max_s": 120.0,
    "idle_pose_default": "Stand Up"
  },
  "advanced": {
    "file_poll_interval_s": 0.1,
    "verbose_log": false
  },
  "ui": {
    "first_run_hint_dismissed": false
  },
  "poses": {
    "commands": [
      {
        "command": "Sit Down",
        "pose": "Sit Down"
      },
      {
        "command": "Lay Down",
        "pose": "Lay Down"
      },
      {
        "command": "Prone",
        "pose": "Prone"
      },
      {
        "command": "Stand Up",
        "pose": "Stand Up"
      },
      {
        "command": "Spread Your Legs",
        "pose": "Spread Your Legs"
      },
      {
        "command": "Ankle Your Knees",
        "pose": "Ankle Your Knees"
      },
      {
        "command": "Ankle Your Elbows",
        "pose": "Ankle Your Elbows"
      },
      {
        "command": "Turn Around",
        "pose": "Turn Around"
      },
      {
        "command": "Crawl on all fours",
        "pose": "Crawl on all fours"
      },
      {
        "command": "Bend Over",
        "pose": "Bend Over"
      }
    ]
  },
  "setup": {
    "asked": false,
    "green_background": false,
    "example_scene": false
  },
  "remote": {
    "enabled": false,
    "http_port": 38438,
    "osc_port": 0,
    "token": ""
  },
  "ai": {
    "mode": "qa",
    "persona": "You are a friendly, curious character living in a 3D scene. You talk with the user face to face. Answer briefly and naturally, in the language the user speaks.",
    "language": "auto",
    "persona_name": "",
    "memory": {
      "enabled": false,
      "max_facts": 30,
      "session_idle_minutes": 10,
      "min_exchanges": 2
    },
    "fallback": {
      "stt": "null",
      "llm": "echo",
      "tts": "tone"
    },
    "realtime": {
      "url": "wss://api.x.ai/v1/realtime",
      "model": "grok-voice-latest",
      "voice": "eve",
      "sample_rate": 24000,
      "speed": 1.0,
      "reasoning_effort": "none",
      "send_while_speaking": false,
      "first_segment_s": 1.2,
      "max_segment_s": 6.0,
      "connect_timeout_s": 15.0
    },
    "proactive": {
      "enabled": true,
      "idle_seconds": 90.0,
      "prompt": "The user has been quiet for a while. You may say something short and spontaneous that fits the moment and your character (a remark, a thought, a question), or you may stay silent. If you prefer to stay silent, answer with exactly [silent] and nothing else."
    },
    "scene_events": {
      "enabled": true,
      "prompt": "Something just happened in the scene: {event}. You may react briefly and in character if it fits, or you may stay silent. If you prefer to stay silent, answer with exactly [silent] and nothing else."
    },
    "emotion": {
      "fallback": true,
      "fade": true,
      "fade_after_s": 6.0,
      "fade_seconds": 2.5,
      "listening": true
    },
    "barge_in": {
      "enabled": false,
      "ratio": 2.0,
      "min_ms": 600,
      "floor": 0.02
    },
    "xai": {
      "base_url": "https://api.x.ai/v1",
      "key_hint": "An xAI API key from console.x.ai is required (a Grok subscription does not work). Provide it in one of four ways: (1) in VaM, plugin tab Voice > Voice Mode, field 'XAI API Token' (below API Reconnect); the plugin saves it here as ai.xai.api_key; (2) write it into ai.xai.api_key yourself; (3) the environment variable XAI_API_KEY; (4) ai.xai.key_file = path of a text file that holds the key. If several are set, the plugin field (while VaM runs) wins, then ai.xai.api_key, then XAI_API_KEY, then key_file.",
      "api_key": "",
      "api_key_warning": "SECURITY NOTICE: Your xAI token is stored as plain text in config.json (ai.xai.api_key). Anyone who can read that file can read your token, so do not share or publish it. Since version 31 no scene holds the token any more, but a scene saved with AIBody version 21 to 23 still contains the full token: do not publish such a scene.",
      "key_file": "",
      "model": "grok-4.7",
      "max_output_tokens": 400,
      "stt_model": "grok-voice-transcribe-2.0",
      "voice": "eve",
      "speed": 1.0,
      "sample_rate": 24000,
      "timeout_s": 60.0
    },
    "ollama": {
      "base_url": "http://127.0.0.1:11434",
      "model": "llama3.2",
      "max_output_tokens": 400,
      "temperature": 0.7,
      "keep_alive": "10m",
      "max_messages": 40,
      "timeout_s": 120.0
    },
    "elevenlabs": {
      "base_url": "https://api.elevenlabs.io/v1",
      "key_file": "",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "model_id": "eleven_multilingual_v2",
      "output_format": "pcm_24000",
      "timeout_s": 60.0
    }
  }
}
